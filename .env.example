# Copy to .env.local and fill in real values. Never commit secrets.

# --- Site (browser-visible) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Creem (server-only) ---
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# Optional override; defaults to test-api.creem.io in dev, api.creem.io in production.
# CREEM_API_BASE_URL=

# --- Supabase (server-only) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private-products

# --- Payment provider: "creem" (default) or "mock" ---
PAYMENT_PROVIDER=creem
